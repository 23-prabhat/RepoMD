# Primary repository analysis and chat provider
OPENCODE_API_KEY=your_opencode_zen_api_key
OPENCODE_MODEL=deepseek-v4.1-flash

# Fallback provider, used when the primary provider is unavailable
GROQ_API_KEY=your_groq_api_key

# Optional: raises GitHub API rate limits and allows access to authorized repositories
GITHUB_TOKEN=your_github_token
